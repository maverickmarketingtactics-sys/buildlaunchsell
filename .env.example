# Calendly (or equivalent). Default #book jumps to the homepage booking band.
# Set to /apply for a dedicated booking page, or a full https URL when live.
NEXT_PUBLIC_BOOKING_URL=#book

# $2,900 refundable working-version deposit. Neutral label in the UI.
# Default is the current Whop checkout until BuildLaunchSell has its own.
NEXT_PUBLIC_ACCEPTANCE_URL=https://whop.com/checkout/plan_Sz7TIXY8KaN4U

# Optional: Meta / Facebook Pixel ID. Leave blank until the pixel is created.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional: Loom / Wistia / YouTube embed URL for the VSL slot.
NEXT_PUBLIC_VSL_EMBED_URL=

# Canonical site URL for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://buildlaunchsell.com

# Bearer token for PUT /api/proposals/:slug (instant proposal publish).
# Leave empty locally until you need to test publish scripts.
PROPOSAL_ADMIN_SECRET=
